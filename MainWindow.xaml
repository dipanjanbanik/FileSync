<Window x:Class="FileSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FileSync"
        mc:Ignorable="d"
        Title="FileSync" Height="650" Width="1240"
        MinHeight="500" MinWidth="740"
        Background="White" FontFamily="Segoe UI" FontSize="12"
        Icon="ImagesAndDocuments/ICOFiles/app_icon.ico">
    <Window.Resources>
        <Style x:Key="BrowseButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Padding" Value="8,0" />
        </Style>
        <Style x:Key="StatusCounterStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="ComparisonRowStyle" TargetType="DataGridRow">
            <Setter Property="ToolTip" Value="{Binding Message}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMismatch}" Value="True">
                    <Setter Property="Background" Value="#FFFFCC80" />
                    <Setter Property="Foreground" Value="Black" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ComparisonGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="RowHeight" Value="25" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="RowStyle" Value="{StaticResource ComparisonRowStyle}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="100" />
            <RowDefinition Height="10" />
            <RowDefinition Height="150" MinHeight="70" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="Source" VerticalAlignment="Center" Height="16" />
            <TextBox Grid.Row="0" x:Name="SourcePathTextBox" Grid.Column="1"
                     Height="22" VerticalAlignment="Center" VerticalContentAlignment="Center"
                     Padding="3,0" AutomationProperties.Name="Source folder" TextChanged="FolderPathChanged" />
            <Button Grid.Row="0" x:Name="BrowseSourceButton" Grid.Column="2" Content="Browse"
                                Style="{StaticResource BrowseButtonStyle}" Click="BrowseSource" Margin="10,4,10,4" />

            <TextBlock Grid.Column="0" Grid.Row="1" Text="Destination" VerticalAlignment="Center" Height="16" />
            <TextBox x:Name="DestinationPathTextBox" Grid.Row="1" Grid.Column="1"
                     Height="22" VerticalAlignment="Center" VerticalContentAlignment="Center"
                     Padding="3,0" AutomationProperties.Name="Destination folder" TextChanged="FolderPathChanged" />
            <Button x:Name="BrowseDestinationButton" Grid.Row="1" Grid.Column="2" Content="Browse"
                    Style="{StaticResource BrowseButtonStyle}" Click="BrowseDestination" Margin="10,4,10,4" />

            <Button x:Name="SwitchSidesButton" Grid.Row="0" Grid.Column="3" Height="22" Margin="10,4,10,4"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    Click="SwitchSides" ToolTip="Switch sides" AutomationProperties.Name="Switch sides">
                <Image Source="ImagesAndDocuments/ICOFiles/flip_source_dest.ico"
                       Width="22" Height="22" Stretch="Uniform" />
            </Button>
            <Button x:Name="ScanButton" Grid.Row="1" Grid.Column="3" Content="Scan"
                    Style="{StaticResource BrowseButtonStyle}" Margin="10,4,10,4"
                    IsEnabled="False" Click="ScanFolders" ToolTip="Compare the selected folders"
                    AutomationProperties.Name="Scan folders" />

            <Button x:Name="StartButton" Grid.Row="0" Grid.Column="4" Content="Start"
                    Width="60" Style="{StaticResource BrowseButtonStyle}" Margin="10,4,10,4"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Click="StartSynchronization" IsEnabled="False"
                    ToolTip="Start synchronization" AutomationProperties.Name="Start synchronization" />
            <Button x:Name="StopButton" Grid.Row="1" Grid.Column="4" Content="Stop"
                    Width="60" Style="{StaticResource BrowseButtonStyle}" Margin="10,4,10,4"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Click="StopSynchronization" IsEnabled="False"
                    ToolTip="Stop synchronization" AutomationProperties.Name="Stop synchronization" />

            <ComboBox x:Name="SynchronizationRuleComboBox" Grid.Row="0" Grid.Column="5"
                      Height="22" Margin="10,4,10,4" FontSize="10"
                      VerticalContentAlignment="Center" DisplayMemberPath="Name"
                      ToolTip="{Binding SelectedItem.RuleSummary, RelativeSource={RelativeSource Self}}"
                      AutomationProperties.Name="Synchronization rule" />

            <TextBlock Grid.Column="0" Grid.Row="2" Text="View" VerticalAlignment="Center" Height="16" />
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                        Orientation="Horizontal" VerticalAlignment="Center" Height="28">
                <ComboBox x:Name="ViewFilterComboBox" Width="140" Height="28" SelectedIndex="0"
                          VerticalContentAlignment="Center" AutomationProperties.Name="View filter">
                    <ComboBoxItem Content="All files" />
                    <ComboBoxItem Content="Pending" />
                    <ComboBoxItem Content="Ongoing" />
                    <ComboBoxItem Content="Failed" />
                    <ComboBoxItem Content="Success" />
                </ComboBox>
                <CheckBox x:Name="LockScrollBarCheckBox" Content="Lock ScrollBar" IsChecked="True"
                          Margin="12,0,0,0" VerticalAlignment="Center" Checked="LockScrollBarChecked"
                          ToolTip="Scroll both tables together horizontally and vertically" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="Black" BorderThickness="0,0,1,1" Padding="10,0,4,0" Name="FileStatusDisplay">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Source" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock x:Name="PendingCounterTextBlock" Style="{StaticResource StatusCounterStyle}">
                                <Run Text="Pending:" />
                                <Run x:Name="PendingCountRun" Text="0" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock x:Name="OngoingCounterTextBlock" Style="{StaticResource StatusCounterStyle}">
                                <Run Text="Ongoing:" />
                                <Run x:Name="OngoingCountRun" Text="0" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock x:Name="FailedCounterTextBlock" Style="{StaticResource StatusCounterStyle}">
                                <Run Text="Failed:" />
                                <Run x:Name="FailedCountRun" Text="0" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock x:Name="SuccessCounterTextBlock" Style="{StaticResource StatusCounterStyle}">
                                <Run Text="Success:" />
                                <Run x:Name="SuccessCountRun" Text="0" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,0,1" Padding="5,0,4,0">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Destination" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock x:Name="OverwrittenCounterTextBlock" Style="{StaticResource StatusCounterStyle}">
                                <Run Text="Overwritten:" />
                                <Run x:Name="OverwrittenCountRun" Text="0" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock x:Name="NewCounterTextBlock" Style="{StaticResource StatusCounterStyle}">
                                <Run Text="New:" />
                                <Run x:Name="NewCountRun" Text="0" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock x:Name="DeletedCounterTextBlock" Style="{StaticResource StatusCounterStyle}">
                                <Run Text="Deleted:" />
                                <Run x:Name="DeletedCountRun" Text="0" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock x:Name="SkippedCounterTextBlock" Style="{StaticResource StatusCounterStyle}">
                                <Run Text="Skipped:" />
                                <Run x:Name="SkippedCountRun" Text="0" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Grid.Column="0" Grid.Row="1" BorderBrush="Black" BorderThickness="0,0,1,0">
                    <DataGrid x:Name="SourceFilesDataGrid" Style="{StaticResource ComparisonGridStyle}"
                              Sorting="SortComparisonTables" Loaded="ComparisonGridLoaded"
                              ScrollViewer.ScrollChanged="ComparisonGridScrollChanged"
                              AutomationProperties.Name="Source folder comparison">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Relative path" Binding="{Binding RelativePath}" Width="*"
                                                MinWidth="140" />
                            <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="55" />
                            <DataGridTextColumn Header="Size (bytes)" Binding="{Binding SizeDisplay}" SortMemberPath="SizeBytes" Width="85" />
                            <DataGridTextColumn Header="Date modified" Binding="{Binding ModifiedDisplay}" SortMemberPath="LastWriteTimeUtc" Width="205" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <DataGrid x:Name="DestinationFilesDataGrid" Grid.Row="1" Grid.Column="1"
                          Style="{StaticResource ComparisonGridStyle}"
                          Sorting="SortComparisonTables" Loaded="ComparisonGridLoaded"
                          ScrollViewer.ScrollChanged="ComparisonGridScrollChanged"
                          AutomationProperties.Name="Destination folder comparison">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Relative path" Binding="{Binding RelativePath}" Width="*"
                                            MinWidth="140" />
                        <DataGridTextColumn Header="Type" Binding="{Binding EntryType}" Width="55" />
                        <DataGridTextColumn Header="Size (bytes)" Binding="{Binding SizeDisplay}" SortMemberPath="SizeBytes" Width="85" />
                        <DataGridTextColumn Header="Date modified" Binding="{Binding ModifiedDisplay}" SortMemberPath="LastWriteTimeUtc" Width="205" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                      Background="LightGray" Cursor="SizeNS"
                      ToolTip="Drag up or down to resize the file status and activity log heights"
                      AutomationProperties.Name="Resize file status and activity log heights" />

        <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1" Name="LogInProgress">
            <DataGrid x:Name="ActivityLogDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      BorderThickness="0" Background="White" RowHeight="28" FontSize="11"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Synchronization activity log">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding Message}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Running">
                                <Setter Property="Background" Value="#FFE3F2FD" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                <Setter Property="Background" Value="#FFFFCDD2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Start Date / Time" Width="160"
                                        Binding="{Binding StartedAt, StringFormat=dd.MM.yyyy HH:mm:ss}" />
                    <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="2*" MinWidth="180" />
                    <DataGridTextColumn Header="File Ruling" Binding="{Binding Rule}" Width="2*" MinWidth="180" />
                    <DataGridTemplateColumn Header="Progress" Width="140" SortMemberPath="Progress">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" />
                                    <TextBlock Text="{Binding Progress, StringFormat={}{0}%}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <TextBlock x:Name="ApplicationVersionTextBlock" Grid.Row="4" Margin="0,5,0,0"
                   HorizontalAlignment="Right" Foreground="DimGray" FontSize="10"
                   AutomationProperties.Name="Application version" />
    </Grid>
</Window>